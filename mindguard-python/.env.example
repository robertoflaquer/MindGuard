# MindGuard Python Engine — copie para .env e preencha os valores

# Servidor
PORT=8000

# Banco de dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=mindguard
DB_USER=postgres
DB_PASSWORD=MindGuard!

# Redis (opcional)
REDIS_HOST=localhost
REDIS_PORT=6379

# Parâmetros de processamento
BASELINE_MIN_DAYS=7
BASELINE_MAX_DAYS=14
DEVIATION_THRESHOLD=15.0
TREND_MIN_DATAPOINTS=5

# Thresholds de risco
RISK_CONVERGENCE_THRESHOLD=2
HIGH_RISK_THRESHOLD=70
ATTENTION_THRESHOLD=40
